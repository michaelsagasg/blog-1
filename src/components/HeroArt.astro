---
const chain: [number, number][] = [
  [36, 196], [70, 146], [114, 112], [162, 96], [210, 70], [260, 54],
  [312, 60], [362, 42], [410, 64], [452, 100], [494, 84], [530, 122],
];
const tones = ['amber', 'green', 'coral', 'cobalt'];
const hex = (cx: number, cy: number, r = 16) =>
  [[0, -r], [r * 0.866, -r / 2], [r * 0.866, r / 2], [0, r], [-r * 0.866, r / 2], [-r * 0.866, -r / 2]]
    .map(([x, y]) => `${(cx + x).toFixed(1)},${(cy + y).toFixed(1)}`).join(' ');
---
<svg class="hero-art" viewBox="0 0 560 480" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ha-liquid" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffc857" />
      <stop offset="1" stop-color="#e2650f" />
    </linearGradient>
    <linearGradient id="ha-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#ffb02e" stop-opacity=".30" />
      <stop offset=".45" stop-color="#ffb02e" stop-opacity=".10" />
      <stop offset="1" stop-color="#ffb02e" stop-opacity=".26" />
    </linearGradient>
    <linearGradient id="ha-cap" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".35" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <clipPath id="ha-v1"><rect x="210" y="170" width="140" height="270" rx="26" /></clipPath>
    <clipPath id="ha-v2"><rect x="96" y="290" width="84" height="150" rx="18" /></clipPath>
    <clipPath id="ha-v3"><rect x="380" y="250" width="96" height="190" rx="20" /></clipPath>
  </defs>

  <g class="ha-chain">
    <g class="ha-bonds">
      <polyline points={chain.map((p) => p.join(',')).join(' ')} />
      <line x1="162" y1="96" x2="150" y2="44" />
      <line x1="410" y1="64" x2="424" y2="150" />
    </g>
    <g class="ha-rings">
      <polygon points={hex(146, 30)} /><circle cx="146" cy="30" r="8" />
      <polygon points={hex(428, 166)} /><circle cx="428" cy="166" r="8" />
    </g>
    {chain.map(([x, y], i) => <circle class={`ha-bead t-${tones[i % 4]}`} cx={x} cy={y} r={i % 3 === 1 ? 13 : 10} />)}
  </g>

  <ellipse cx="286" cy="446" rx="220" ry="12" fill="#000" opacity=".35" />

  <g class="ha-vial">
    <rect x="112" y="272" width="52" height="22" rx="4" class="ha-neck" />
    <rect x="106" y="246" width="64" height="30" rx="7" fill="#2fbf8a" />
    <rect x="106" y="246" width="64" height="14" rx="7" fill="url(#ha-cap)" />
    <rect x="96" y="290" width="84" height="150" rx="18" fill="url(#ha-glass)" class="ha-outline" />
    <g clip-path="url(#ha-v2)">
      <rect x="96" y="352" width="84" height="90" fill="url(#ha-liquid)" />
      <ellipse cx="138" cy="352" rx="42" ry="5" fill="#ffd98a" />
      <circle class="ha-bub" cx="120" cy="428" r="2.5" />
      <circle class="ha-bub b2" cx="150" cy="432" r="3" />
    </g>
    <rect x="106" y="302" width="8" height="126" rx="4" fill="#fff" opacity=".22" />
  </g>

  <g class="ha-vial">
    <rect x="398" y="228" width="60" height="26" rx="4" class="ha-neck" />
    <rect x="390" y="196" width="76" height="36" rx="8" fill="#3a63e8" />
    <rect x="390" y="196" width="76" height="16" rx="8" fill="url(#ha-cap)" />
    <rect x="380" y="250" width="96" height="190" rx="20" fill="url(#ha-glass)" class="ha-outline" />
    <g clip-path="url(#ha-v3)">
      <rect x="380" y="330" width="96" height="112" fill="url(#ha-liquid)" />
      <ellipse cx="428" cy="330" rx="48" ry="6" fill="#ffd98a" />
      <circle class="ha-bub b3" cx="404" cy="430" r="3" />
      <circle class="ha-bub" cx="446" cy="426" r="2" />
    </g>
    <rect x="392" y="264" width="9" height="162" rx="4.5" fill="#fff" opacity=".22" />
  </g>

  <g class="ha-vial">
    <rect x="236" y="140" width="88" height="36" rx="5" class="ha-neck" />
    <rect x="226" y="98" width="108" height="48" rx="10" fill="#ff5b3a" />
    <rect x="242" y="86" width="76" height="18" rx="6" fill="#ff8a6e" />
    <rect x="226" y="98" width="108" height="20" rx="10" fill="url(#ha-cap)" />
    <rect x="210" y="170" width="140" height="270" rx="26" fill="url(#ha-glass)" class="ha-outline" />
    <g clip-path="url(#ha-v1)">
      <rect x="210" y="262" width="140" height="180" fill="url(#ha-liquid)" />
      <ellipse cx="280" cy="262" rx="70" ry="7" fill="#ffd98a" />
      <circle class="ha-bub" cx="246" cy="430" r="4" />
      <circle class="ha-bub b2" cx="300" cy="436" r="3" />
      <circle class="ha-bub b3" cx="272" cy="428" r="2.5" />
      <circle class="ha-bub b4" cx="322" cy="432" r="3.5" />
    </g>
    <rect x="224" y="186" width="12" height="238" rx="6" fill="#fff" opacity=".24" />
    <g class="ha-ticks">
      <line x1="332" y1="200" x2="344" y2="200" /><line x1="336" y1="220" x2="344" y2="220" />
      <line x1="332" y1="240" x2="344" y2="240" /><line x1="336" y1="260" x2="344" y2="260" />
    </g>
    <rect x="232" y="306" width="96" height="84" rx="6" fill="#fbf6ec" />
    <rect x="232" y="306" width="96" height="14" rx="6" fill="#ff5b3a" />
    <rect x="232" y="313" width="96" height="7" fill="#ff5b3a" />
    <text x="242" y="340" class="ha-label">PEPTIDE</text>
    <text x="242" y="356" class="ha-label sm">LOT 2026·09</text>
    <g fill="#10201c">
      <rect x="242" y="366" width="2" height="16" /><rect x="246" y="366" width="1" height="16" />
      <rect x="249" y="366" width="3" height="16" /><rect x="254" y="366" width="1" height="16" />
      <rect x="257" y="366" width="2" height="16" /><rect x="261" y="366" width="1" height="16" />
      <rect x="264" y="366" width="3" height="16" /><rect x="269" y="366" width="1" height="16" />
      <rect x="272" y="366" width="2" height="16" /><rect x="276" y="366" width="1" height="16" />
    </g>
  </g>
</svg>
